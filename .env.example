# Public Firebase web configuration. These values identify the project; access
# control is enforced by Firebase Authentication and Firestore Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=proclean-siteclean.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=proclean-siteclean
VITE_FIREBASE_STORAGE_BUCKET=proclean-siteclean.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Keep false during migration. Enable in Preview only after Auth users and
# UID-keyed Firestore profiles have been created.
VITE_FIREBASE_AUTH_REQUIRED=false

# Optional legacy REST endpoint. Leave empty on Vercel when Firestore is the
# sole production data source.
VITE_API_BASE_URL=
